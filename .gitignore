# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/

# OS
.DS_Store
Thumbs.db

# Keystores. The RELEASE key must never land here.
#
# The debug key is the documented exception and IS committed: Google Sign-In
# identifies the app by (application id, signing certificate SHA-1), so a key
# that Gradle regenerates per machine would break sign-in on every build but
# one. See signingConfigs in app/build.gradle.kts.
*.keystore
*.jks
*.p12
!keystore/upgrid-debug.p12
release/

# Logs
*.log

# Working files for chat/UI-review — never part of the app
screenshots/

# Build artifacts
*.apk
*.aab

# Tooling caches
.kotlin/
.claude/
