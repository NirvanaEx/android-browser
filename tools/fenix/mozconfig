# Android frontend built against precompiled Gecko artifacts.
ac_add_options --enable-project=mobile/android
ac_add_options --enable-artifact-builds
ac_add_options --enable-android-subproject=fenix
ac_add_options --disable-android-bundle
ac_add_options --target=aarch64
ac_add_options --with-android-sdk="${MOZBUILD_STATE_PATH:-$HOME/.mozbuild}/android-sdk-linux"
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/objdir-upgrid
