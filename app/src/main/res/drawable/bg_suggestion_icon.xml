<?xml version="1.0" encoding="utf-8"?>
<!--
  Round holder behind a suggestion's kind icon. Bare 20dp glyphs of three
  different shapes (star, clock, magnifier) at three different optical weights
  made the left edge of the list look ragged; a circle of one size squares
  them up and gives the row a place to start.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/colorSurfaceContainerHighest" />
</shape>
