<?xml version="1.0" encoding="utf-8"?>
<!--
  Surface behind the omnibar drop-down.

  A step up from colorSurface on purpose. Painted in the page's own colour the
  panel had no edge at all — the rows read as text scattered over the start
  page rather than as a list hanging off the address bar. It is now inset from
  both screen edges and elevated, so all four corners are rounded: it's a card
  floating under the field, not a section of the window.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
