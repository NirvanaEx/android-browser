<?xml version="1.0" encoding="utf-8"?>
<!--
  Circular scrim behind a floating player button. Dark enough to keep a white
  glyph readable over any frame of video, transparent enough not to look like a
  hole punched in the picture.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#99000000" />
</shape>
