<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background: the brand blue, as a diagonal gradient rather than a
  flat fill.

  Flat looked unfinished next to every other icon on a modern launcher, and a
  gradient costs nothing — this is one path and one shader, evaluated once when
  the icon is rasterised. It runs light at the top-left to dark at the
  bottom-right so the shield's upper edge has something to stand out against.

  Full-bleed on purpose: the background layer of an adaptive icon is expected to
  fill the whole 108 × 108 canvas, because the launcher crops it to its own mask
  and parallaxes it under the foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="@color/brand_gradient_start"
                android:endColor="@color/brand_gradient_end" />
        </aapt:attr>
    </path>
</vector>
