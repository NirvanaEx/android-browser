<?xml version="1.0" encoding="utf-8"?>
<!--
  Tab card in the grid tray. The selected tab gets an accent border and a tinted
  fill so it's findable at a glance in a wall of similar cards. Ripple is layered
  separately via android:foreground so the stroke doesn't clip it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutlineVariant" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
