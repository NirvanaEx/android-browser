<?xml version="1.0" encoding="utf-8"?>
<!--
  The "new tab" square on the tabs screen. Filled rather than an outline: it is
  the one thing on that screen that isn't about a tab you already have, and the
  only reason to come here without wanting to pick one.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSecondaryContainer" />
    <corners android:radius="14dp" />
</shape>
