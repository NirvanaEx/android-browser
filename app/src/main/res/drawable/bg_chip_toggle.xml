<?xml version="1.0" encoding="utf-8"?>
<!--
  Segmented chip: the two halves of the translate bar's language switch.
  Selected = filled with the brand colour, unselected = outline only. Same
  shape either way, so the pair reads as one control rather than as two
  unrelated buttons.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimary" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutline" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
