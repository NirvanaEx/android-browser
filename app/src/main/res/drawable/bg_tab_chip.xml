<?xml version="1.0" encoding="utf-8"?>
<!--
  One tab in the desktop-style strip. The current one is filled with the tonal
  colour, the rest sit on a container shade — the same two-step the tabs screen
  uses, so a tab looks like the same object in both places.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSecondaryContainer" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
