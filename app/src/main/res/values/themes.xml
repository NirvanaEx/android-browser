<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 theme with the Upgrid brand palette explicitly bound. We don't
  enable dynamic color (Material You) here — keeping the brand consistent across
  devices is more important for an early-MVP browser than matching wallpaper.
  Bind dynamic color later in BrowserApplication if/when we want it.
-->
<resources>
    <style name="Theme.UpgridBrowser" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/md_primary_light</item>
        <item name="colorOnPrimary">@color/md_on_primary_light</item>
        <item name="colorPrimaryContainer">@color/md_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container_light</item>

        <!-- Secondary / tertiary -->
        <item name="colorSecondary">@color/md_secondary_light</item>
        <item name="colorOnSecondary">@color/md_on_secondary_light</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container_light</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container_light</item>
        <item name="colorTertiary">@color/md_tertiary_light</item>
        <item name="colorOnTertiary">@color/md_on_tertiary_light</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container_light</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container_light</item>

        <!-- Error -->
        <item name="colorError">@color/md_error_light</item>
        <item name="colorOnError">@color/md_on_error_light</item>
        <item name="colorErrorContainer">@color/md_error_container_light</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container_light</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/md_background_light</item>
        <item name="colorOnBackground">@color/md_on_background_light</item>
        <item name="colorSurface">@color/md_surface_light</item>
        <item name="colorOnSurface">@color/md_on_surface_light</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant_light</item>
        <item name="colorSurfaceContainer">@color/md_surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest_light</item>

        <item name="colorOutline">@color/md_outline_light</item>
        <item name="colorOutlineVariant">@color/md_outline_variant_light</item>

        <!-- System bars.
             The nav bar used to be colorSurfaceContainer to match the bottom
             bar sitting right above it. With that bar gone the strip is now
             directly under the page, and the contrast step read as a seam —
             colorSurface continues the page instead. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!--
          How screens replace each other. Bound on the theme rather than
          called at each startActivity: there are nine activities and the
          transition is a property of the app, not of any one caller.
        -->
        <item name="android:windowAnimationStyle">@style/Animation.UpgridBrowser.Activity</item>

        <!-- BottomSheet → rounded top corners + brand surface -->
        <item name="bottomSheetDialogTheme">@style/Theme.UpgridBrowser.BottomSheet</item>

        <!-- Every MaterialAlertDialog in the app, not one at a time. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.UpgridBrowser.Dialog</item>
    </style>

    <!--
      Dialogs. Bound on the theme rather than passed to each builder so that
      "add a shortcut", "remove a shortcut" and the sign-in explainer can't
      drift apart — which is how the app ended up with one dialog that looked
      hand-made and two that didn't.

      The positive button is tonal: in a two-button dialog the confirming
      action should be the one your eye lands on, and two identical text
      buttons make the user read both before choosing.
    -->
    <style name="ThemeOverlay.UpgridBrowser.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:dialogCornerRadius">28dp</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.UpgridBrowser.DialogButton.Confirm</item>
    </style>

    <style name="Widget.UpgridBrowser.DialogButton.Confirm" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <!--
      Screen-to-screen motion. Material's forward/backward pair: the arriving
      screen comes up from slightly behind and settles, the one it covers eases
      forward and fades, and going back is the exact reverse — so "back" undoes
      what "forward" did rather than being a second, different animation.

      Not a slide. History, bookmarks, downloads and the tabs screen all live
      *inside* the browser; sliding in from an edge is the idiom for the next
      thing along, which none of them are.
    -->
    <style name="Animation.UpgridBrowser.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>

    <!-- The app menu's PopupWindow. Pivots on the button it hangs from. -->
    <style name="Animation.UpgridBrowser.Menu" parent="">
        <item name="android:windowEnterAnimation">@anim/menu_enter</item>
        <item name="android:windowExitAnimation">@anim/menu_exit</item>
    </style>

    <style name="Theme.UpgridBrowser.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.UpgridBrowser.BottomSheet</item>
    </style>

    <style name="Widget.UpgridBrowser.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.UpgridBrowser.BottomSheet</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="ShapeAppearance.UpgridBrowser.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
