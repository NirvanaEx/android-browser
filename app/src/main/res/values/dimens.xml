<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides for android-components resources. App resources win over library
  ones at merge time, which is the only lever available for values baked into
  a library's own layouts.
-->
<resources>
    <!--
      Suppress BrowserToolbar's built-in progress bar.

      It's a child of the toolbar, so it spans the URL chip and nothing else —
      a load indicator that stops two thirds of the way across the screen looks
      like a stalled page. We draw our own full-width one under the top bar
      (pageProgress in activity_main.xml). Zero height is how you turn the
      library's off without forking its layout; DisplayToolbar still flips its
      visibility, which now costs nothing.
    -->
    <dimen name="mozac_browser_toolbar_progress_bar_height">0dp</dimen>

    <!--
      The tablet tab strip. Tabs divide the strip's width between them and are
      clamped to this pair, which is the whole of the sizing rule (see
      TabStripAdapter): wide enough at the bottom end to still show a favicon
      and the first word, capped at the top end because a browser with two tabs
      open should not draw two half-screen slabs.

      The ✕ needs room of its own, so below tab_strip_close_min it is dropped
      from every tab but the current one — the same trade Chrome makes, and the
      alternative is a close button that overlaps the title it belongs to.
    -->
    <dimen name="tab_strip_tab_min">92dp</dimen>
    <dimen name="tab_strip_tab_max">220dp</dimen>
    <dimen name="tab_strip_close_min">124dp</dimen>

    <!-- The "+" cell at the end of the strip. Reserved out of the width the
         tabs divide, so the last tab never ends up underneath it. -->
    <dimen name="tab_strip_new_width">42dp</dimen>

    <!-- The start page's margins. Overridden in values-sw600dp, where the
         content stays a column instead of stretching to the screen's width. -->
    <dimen name="start_page_side">20dp</dimen>
    <dimen name="start_page_top">40dp</dimen>
</resources>
