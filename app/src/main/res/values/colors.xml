    <!-- Dark scheme -->
    <color name="md_primary_dark">#B0C7FF</color>
    <color name="md_on_primary_dark">#002F6E</color>
    <color name="md_primary_container_dark">#00468F</color>
    <color name="md_on_primary_container_dark">#DCE7FF</color>

    <color name="md_secondary_dark">#BEC6DC</color>
    <color name="md_on_secondary_dark">#283041</color>
    <color name="md_secondary_container_dark">#3E4759</color>
