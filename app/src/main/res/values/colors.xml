<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand palette. Single source of truth for colors that the M3 theme attributes
  remap to. Don't reference these directly from layouts — go through ?attr/colorXxx
  so light/dark stays consistent.
-->
<resources>
    <!-- Launcher / brand seed. Matches mipmap ic_launcher background. -->
    <color name="brand_blue">#1F6FEB</color>
    <color name="brand_blue_dark">#00468F</color>
    <color name="brand_blue_light">#B0C7FF</color>

    <!--
      The launcher gradient. Lighter than brand_blue at the top-left and
      considerably darker at the bottom-right: the icon is 48dp on a home
      screen and a flat fill at that size disappears into whatever wallpaper is
      behind it, while a diagonal ramp gives the shield an edge to stand on.
      Also used by ic_brand_mark on the sign-in screen, so the two can't drift.
    -->
    <color name="brand_gradient_start">#3B82F7</color>
    <color name="brand_gradient_end">#0A3A9E</color>

    <color name="ic_launcher_background">@color/brand_blue</color>

    <!-- Light scheme (Material 3 baseline derived from brand_blue) -->
    <color name="md_primary_light">#1F6FEB</color>
    <color name="md_on_primary_light">#FFFFFF</color>
    <color name="md_primary_container_light">#DCE7FF</color>
    <color name="md_on_primary_container_light">#001A45</color>

    <color name="md_secondary_light">#555F71</color>
    <color name="md_on_secondary_light">#FFFFFF</color>
    <color name="md_secondary_container_light">#DAE2F9</color>
    <color name="md_on_secondary_container_light">#121C2B</color>

    <color name="md_tertiary_light">#705575</color>
    <color name="md_on_tertiary_light">#FFFFFF</color>
    <color name="md_tertiary_container_light">#FAD8FD</color>
    <color name="md_on_tertiary_container_light">#28132E</color>

    <color name="md_error_light">#BA1A1A</color>
    <color name="md_on_error_light">#FFFFFF</color>
    <color name="md_error_container_light">#FFDAD6</color>
    <color name="md_on_error_container_light">#410002</color>

    <color name="md_background_light">#FDFCFF</color>
    <color name="md_on_background_light">#1A1B22</color>
    <color name="md_surface_light">#FDFCFF</color>
    <color name="md_on_surface_light">#1A1B22</color>
    <color name="md_surface_variant_light">#E1E2EC</color>
