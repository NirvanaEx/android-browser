<?xml version="1.0" encoding="utf-8"?>
<!--
  One tab in the tablet's top strip, laid out the way a desktop browser lays
  one out.

  Two things here are the difference between "a row of chips" and "tabs":

    - The width is NOT in this file. Tabs share the strip between them and
      shrink as more open, exactly like Chrome — TabStripAdapter sets it, from
      tab_strip_tab_min/max. A fixed width left half the strip empty with three
      tabs open and scrolling with six.
    - The selected tab is painted colorSurface, the same colour as the toolbar
      directly below it, with its top corners rounded and its bottom edge
      square. So it reads as joined to the toolbar and the rest read as sitting
      behind it. That, and not a highlight colour, is what says which tab is in
      front.

  The hairline at the end separates two neighbouring tabs. The adapter hides it
  next to the selected tab and after the last one, since a selected tab already
  has an edge and the strip's end is not a division between anything.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="176dp"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/stripChip"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:background="@drawable/bg_tab_strip_item"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/stripFavicon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_globe"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/stripTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            tools:text="NirvanaEx/android-browser" />

        <ImageButton
            android:id="@+id/btnStripClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tabs_tray_close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <View
        android:id="@+id/stripDivider"
        android:layout_width="1dp"
        android:layout_height="18dp"
        android:layout_gravity="end|center_vertical"
        android:background="?attr/colorOutlineVariant" />
</FrameLayout>
