<?xml version="1.0" encoding="utf-8"?>
<!--
  One tab, as a card in the two-column tray grid.

  The old tray was a single-column list of 60dp rows: on a phone that's five
  tabs on screen and a lot of scrolling to find the sixth. Two columns of cards
  roughly triple that, and the per-host color tile gives the eye something to
  aim at other than reading every title.

  Deliberately no page thumbnail. Capturing one means keeping a bitmap per tab
  alive next to GeckoView's own per-tab memory, and it renders as a grey
  rectangle for every tab that hasn't been visited since the app started —
  which is most of them, right after a session restore.

  Selected state comes from bg_tab_card's selector, set by the adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="5dp"
    android:padding="10dp"
    android:background="@drawable/bg_tab_card"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Favicon when the engine has one, letter tile until then. The two
             are stacked rather than swapped so the tile's color stays visible
             behind a transparent favicon. -->
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp">

            <TextView
                android:id="@+id/tabInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/bg_host_tile"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#FFFFFFFF"
                tools:text="G" />

            <ImageView
                android:id="@+id/tabFavicon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:visibility="gone"
                android:contentDescription="@null"
                tools:visibility="visible"
                tools:src="@drawable/ic_globe" />
        </FrameLayout>

        <TextView
            android:id="@+id/tabHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="github.com" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tabs_tray_close"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:id="@+id/tabTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        tools:text="NirvanaEx/android-browser: GeckoView browser" />
</LinearLayout>
