<?xml version="1.0" encoding="utf-8"?>
<!--
  Signing in to the browser's own account.

  Two fields and a button, on purpose. Everything this screen actually does —
  fetching the VPN profile, filling it in, arming the tunnel — happens after the
  button and is never asked about.

  The server address is at the bottom, small, disclosed only when it matters.
  IDs are referenced by LoginActivity via ViewBinding.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.04"
                android:textColor="?attr/colorPrimary"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/loginTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/account_tagline" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.UpgridBrowser.Field"
                android:hint="@string/account_login"
                app:startIconDrawable="@drawable/ic_key">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/accountLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    tools:text="superadmin" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.UpgridBrowser.Field"
                android:hint="@string/account_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/accountPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:imeOptions="actionDone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/account_sign_in" />

            <TextView
                android:id="@+id/loginStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Профиль получен, VPN настроен." />

            <View style="@style/Widget.UpgridBrowser.SheetDivider" />

            <TextView
                style="@style/Widget.UpgridBrowser.SectionLabel"
                android:layout_marginStart="0dp"
                app:drawableStartCompat="@drawable/ic_settings"
                android:text="@string/account_server_section" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.UpgridBrowser.Field"
                android:hint="@string/account_server"
                app:helperText="@string/account_server_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/accountServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
