<?xml version="1.0" encoding="utf-8"?>
<!--
  "This page is old." A slim line under the address bar saying how long ago
  what you're looking at was actually fetched, with a button to fetch it again.

  It exists because a browser that keeps a page alive for hours — which is the
  goal — creates a problem it didn't have before: nothing on screen says
  whether the prices, the scores or the feed are from now or from breakfast.
  Chrome solves it by quietly reloading and losing your place. This says so
  instead and lets you decide.

  Its own slot rather than the find/translate one: those two are things you
  opened, and this is something the browser noticed. Stacking it under them
  keeps either from hiding the other.

  Ids are bound by MainActivity.renderStaleBar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/colorSurfaceContainer"
    android:paddingStart="14dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_history"
        android:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/staleLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Страница загружена 25 минут назад" />

    <TextView
        android:id="@+id/staleReload"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:text="@string/stale_reload" />

    <ImageButton
        android:id="@+id/staleClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="2dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/find_close"
        android:src="@drawable/ic_close"
        android:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
