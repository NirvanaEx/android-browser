<?xml version="1.0" encoding="utf-8"?>
<!--
  App menu. A drop-down anchored to the ⋮ button (width is set in
  AppMenuPopup.kt; height wraps).

  Top of the menu is the profile: monogram, name, and what the account is doing
  for you. It's a header rather than the seventh row down because it is the one
  line here that answers "who is this browser signed in as", and that question
  was previously answered by a row that looked exactly like "Share".

  Then a strip of four one-tap page actions, then three short groups. Anything
  the user sets once and forgets — ad-blocking defaults, the search engine,
  data management — lives in Settings, not here.

  Row sizing comes from styles.xml; see the note there.
  IDs are bound in AppMenuPopup.kt via ViewBinding.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <!-- ============== Who is signed in ============== -->

        <LinearLayout
            android:id="@+id/rowProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/profileAvatar"
                style="@style/Widget.UpgridBrowser.Avatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:textSize="16sp"
                tools:text="S" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/menu_account_sign_in" />

                <TextView
                    android:id="@+id/profileState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="VPN настроен" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Quick actions ============== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <ImageButton
                android:id="@+id/quickBack"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/nav_back"
                android:src="@drawable/ic_arrow_back" />

            <ImageButton
                android:id="@+id/quickForward"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/nav_forward"
                android:src="@drawable/ic_arrow_forward" />

            <ImageButton
                android:id="@+id/quickReload"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/menu_refresh"
                android:src="@drawable/ic_refresh" />

            <!-- Star: saves / unsaves the page open right now. Icon flips
                 between outline and filled; tint goes primary when saved. -->
            <ImageButton
                android:id="@+id/quickBookmark"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/menu_bookmark_add"
                android:src="@drawable/ic_bookmark" />
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Group 1: places ============== -->

        <LinearLayout
            android:id="@+id/rowNewTab"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_add" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_new_tab" />
        </LinearLayout>

        <!-- Right under "new tab", because that is what it is: a new tab that
             doesn't leave a trace on this phone. -->
        <LinearLayout
            android:id="@+id/rowPrivateTab"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_incognito" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_private_tab" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowBookmarks"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_bookmark" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_bookmarks" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHistory"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_history" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_history" />
        </LinearLayout>

        <!-- Downloads. The count pill is the reason it's here rather than only
             in Settings: "did that file arrive?" is a question you ask from the
             page you were on. -->
        <LinearLayout
            android:id="@+id/rowDownloads"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_download" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_downloads" />
            <TextView
                android:id="@+id/downloadsState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="2" />
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Group 2: this page ============== -->

        <LinearLayout
            android:id="@+id/rowShare"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_share" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowFindInPage"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_find" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_find_in_page" />
        </LinearLayout>

        <!--
          Translate is a per-page action and a toggle: tapping it again on a
          translated page goes back to the original. The label flips with the
          state, so there is one row rather than two.
        -->
        <LinearLayout
            android:id="@+id/rowTranslate"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_translate" />
            <TextView
                android:id="@+id/translateLabel"
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_translate" />
        </LinearLayout>

        <!-- Desktop site is per-tab, so it stays here rather than moving to
             Settings with the other toggles. -->
        <LinearLayout
            android:id="@+id/rowDesktopSite"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_desktop" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_desktop_site" />
            <TextView
                android:id="@+id/desktopSiteState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:text="@string/menu_adblock_state_off" />
        </LinearLayout>

        <!-- AdBlock is also in Settings. Duplicated on purpose: it's the one
             switch this browser exists for, and burying the only copy three
             taps deep would be a strange thing to do to it. -->
        <LinearLayout
            android:id="@+id/rowAdblock"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                android:id="@+id/adblockIcon"
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield"
                android:tint="?attr/colorPrimary" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_adblock" />
            <TextView
                android:id="@+id/adblockState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:text="@string/menu_adblock_state_on" />
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Group 3: connections & settings ============== -->

        <!--
          VPN. A one-tap connect plus the status, because "am I actually
          protected right now?" is the only question a VPN switch has to answer,
          and answering it inside Settings would mean two taps to find out.
          Tapping when nothing is configured opens the setup screen instead.
        -->
        <LinearLayout
            android:id="@+id/rowVpn"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                android:id="@+id/vpnIcon"
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_off" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/menu_vpn" />
                <!-- While the tunnel is up this is the live speed. It is the
                     one thing a VPN row can say that a shield icon can't:
                     connected and carrying nothing looks identical to
                     connected and working. -->
                <TextView
                    android:id="@+id/vpnSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:visibility="visible"
                    tools:text="↓ 1,2 МБ/с   ↑ 240 КБ/с" />
            </LinearLayout>
            <TextView
                android:id="@+id/vpnState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:text="@string/menu_adblock_state_off" />
        </LinearLayout>

        <!--
          Connecting an account is a one-time setup step, and burying the only
          entry point three taps deep inside Settings is how it never gets done.
          The row doubles as the status readout: when connected, the label is
          the account's own address, so "am I signed in?" is answered by opening
          the menu rather than by navigating to find out.
        -->
        <LinearLayout
            android:id="@+id/rowAccount"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <!-- Never tint: the Google mark is four coloured paths and a tint
                 flattens all of them into one. -->
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_google" />
            <TextView
                android:id="@+id/accountLabel"
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:maxLines="1"
                android:ellipsize="middle"
                android:text="@string/menu_account_connect" />
            <TextView
                android:id="@+id/accountState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:visibility="gone"
                android:text="@string/menu_sync_badge"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSettings"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_settings" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
