<?xml version="1.0" encoding="utf-8"?>
<!--
  AppMenuPopup contents. Banana-style narrow column anchored to the menu
  button: groups of rows separated by hairline dividers, each row is icon +
  label + optional state pill / "Soon" tag.

  Width is set in code (300dp via PopupWindow ctor); height wraps. The outer
  ScrollView keeps the menu usable on shorter devices.

  IDs are referenced by AppMenuPopup.kt via ViewBinding.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <!-- ============== Group 1: tabs ============== -->

        <LinearLayout
            android:id="@+id/rowNewTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_add"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_new_tab" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:layout_marginHorizontal="14dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5" />

        <!-- ============== Group 2: page actions ============== -->

        <LinearLayout
            android:id="@+id/rowShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_share"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowFindInPage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_find"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_find_in_page" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_refresh" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDesktopSite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_desktop"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_desktop_site" />
            <TextView
                android:id="@+id/desktopSiteState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_action"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:text="@string/menu_adblock_state_off" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAdblock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/adblockIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield"
                android:tint="?attr/colorPrimary" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_adblock" />
            <TextView
                android:id="@+id/adblockState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_quick_action"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:text="@string/menu_adblock_state_on" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCloseTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_close"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_close_tab" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:layout_marginHorizontal="14dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5" />

        <!-- ============== Group 3: Phase-3 stubs ============== -->

        <LinearLayout
            android:id="@+id/rowBookmarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_bookmark"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_bookmarks" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/menu_pill_soon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_history"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_history" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/menu_pill_soon" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDownloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_download"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_downloads" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textSize="10sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/menu_pill_soon" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:layout_marginHorizontal="14dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.5" />

        <!-- ============== Group 4: Settings ============== -->

        <LinearLayout
            android:id="@+id/rowSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings"
                android:tint="?attr/colorOnSurface" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/menu_settings" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
