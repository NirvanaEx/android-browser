<?xml version="1.0" encoding="utf-8"?>
<!--
  App menu. A 236dp drop-down anchored to the ⋮ button (width is set in
  AppMenuPopup.kt; height wraps).

  It used to be 300dp of 48dp rows including two that only produced a "coming
  soon" toast. Now: a strip of four one-tap page actions on top, then three
  short groups. Anything the user sets once and forgets — ad-blocking defaults,
  the search engine, data management — lives in Settings, not here.

  The quick strip is also where the bottom bar's navigation went. Back is the
  system gesture *and* a button here, because a page that hijacks the gesture
  (galleries, maps) otherwise leaves no way out.

  Row sizing comes from styles.xml; see the note there.
  IDs are bound in AppMenuPopup.kt via ViewBinding.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- ============== Quick actions ============== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="2dp">

            <ImageButton
                android:id="@+id/quickBack"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/nav_back"
                android:src="@drawable/ic_arrow_back" />

            <ImageButton
                android:id="@+id/quickForward"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/nav_forward"
                android:src="@drawable/ic_arrow_forward" />

            <ImageButton
                android:id="@+id/quickReload"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/menu_refresh"
                android:src="@drawable/ic_refresh" />

            <!-- Star: saves / unsaves the page open right now. Icon flips
                 between outline and filled; tint goes primary when saved. -->
            <ImageButton
                android:id="@+id/quickBookmark"
                style="@style/Widget.UpgridBrowser.MenuQuickAction"
                android:contentDescription="@string/menu_bookmark_add"
                android:src="@drawable/ic_bookmark" />
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Group 1: places ============== -->

        <LinearLayout
            android:id="@+id/rowNewTab"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_add" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_new_tab" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowBookmarks"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_bookmark" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_bookmarks" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowHistory"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_history" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_history" />
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Group 2: this page ============== -->

        <LinearLayout
            android:id="@+id/rowShare"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_share" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_share" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowFindInPage"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_find" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_find_in_page" />
        </LinearLayout>

        <!-- Desktop site is per-tab, so it stays here rather than moving to
             Settings with the other toggles. -->
        <LinearLayout
            android:id="@+id/rowDesktopSite"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_desktop" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_desktop_site" />
            <TextView
                android:id="@+id/desktopSiteState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:text="@string/menu_adblock_state_off" />
        </LinearLayout>

        <!-- AdBlock is also in Settings. Duplicated on purpose: it's the one
             switch this browser exists for, and burying the only copy three
             taps deep would be a strange thing to do to it. -->
        <LinearLayout
            android:id="@+id/rowAdblock"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                android:id="@+id/adblockIcon"
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield"
                android:tint="?attr/colorPrimary" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_adblock" />
            <TextView
                android:id="@+id/adblockState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:text="@string/menu_adblock_state_on" />
        </LinearLayout>

        <View style="@style/Widget.UpgridBrowser.MenuDivider" />

        <!-- ============== Group 3: account & settings ============== -->

        <!--
          Connecting an account is a one-time setup step, and burying the only
          entry point three taps deep inside Settings is how it never gets done.
          The row doubles as the status readout: when connected, the label is
          the account's own address, so "am I signed in?" is answered by opening
          the menu rather than by navigating to find out.
        -->
        <LinearLayout
            android:id="@+id/rowAccount"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <!-- Never tint: the Google mark is four coloured paths and a tint
                 flattens all of them into one. -->
            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_google" />
            <TextView
                android:id="@+id/accountLabel"
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:maxLines="1"
                android:ellipsize="middle"
                android:text="@string/menu_account_connect" />
            <TextView
                android:id="@+id/accountState"
                style="@style/Widget.UpgridBrowser.MenuPill"
                android:visibility="gone"
                android:text="@string/menu_sync_badge"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSettings"
            style="@style/Widget.UpgridBrowser.MenuRow">
            <ImageView
                style="@style/Widget.UpgridBrowser.MenuRowIcon"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings" />
            <TextView
                style="@style/Widget.UpgridBrowser.MenuRowLabel"
                android:text="@string/menu_settings" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
