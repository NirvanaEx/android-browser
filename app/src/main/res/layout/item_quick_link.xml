<?xml version="1.0" encoding="utf-8"?>
<!--
  One speed-dial tile. The 64dp filled rounded square holds the brand letter;
  its tint is applied programmatically per QuickLink.color in the adapter.
  Whole row is borderless-ripple clickable so the letter+label feel like one
  cohesive button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="8dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_quick_link"
        android:id="@+id/tileBg">

        <TextView
            android:id="@+id/tileLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
