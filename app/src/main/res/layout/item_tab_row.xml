<?xml version="1.0" encoding="utf-8"?>
<!--
  One open tab, as a list row.

  It used to be a preview card in a two-column grid. Two cards per screen width
  means eight tabs before scrolling and a title cut to three words, and the
  preview itself was a photograph of a page you were about to open anyway. A
  row shows a dozen tabs at once and reads exactly like history and bookmarks —
  same 38dp site icon, same title-over-host stack, same delete affordance on
  the right.

  The selected tab gets a 3dp accent bar at the start rather than a different
  background: a filled row in a list of plain ones looks like a different kind
  of item, and the accent bar says "you are here" without changing the shape.

  IDs are bound in TabViewHolder.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingEnd="4dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <View
        android:id="@+id/tabSelectedBar"
        android:layout_width="3dp"
        android:layout_height="34dp"
        android:background="?attr/colorPrimary"
        android:visibility="invisible"
        tools:visibility="visible" />

    <com.upgrid.browser.ui.SiteIconView
        android:id="@+id/tabIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="9dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tabTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            tools:text="Upgrid Browser — GitHub" />

        <TextView
            android:id="@+id/tabHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="github.com" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tabs_tray_close"
        android:src="@drawable/ic_close"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
