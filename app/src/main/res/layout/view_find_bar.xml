<?xml version="1.0" encoding="utf-8"?>
<!--
  Find in page, directly under the address bar.

  Replaces mozilla's FindInPageBar, which drew a bare EditText hard against the
  left edge with the counter floating in the middle of the row — the layout the
  screenshots called "прям ужасный". Here the query lives in its own filled
  field with the counter inside it (the count belongs to the query, not to the
  bar), and the three buttons are the same 40dp targets used everywhere else in
  the app.

  Ids are bound by FindInPageController.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/colorSurfaceContainer"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bar_field"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_find"
            android:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:includeFontPadding="false"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="15sp"
            tools:text="world" />

        <!-- "3/12". Sits inside the field because it describes the query. -->
        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:includeFontPadding="false"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:text="3/12"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/findPrev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/find_previous"
        android:src="@drawable/ic_chevron_up"
        android:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/findNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/find_next"
        android:src="@drawable/ic_chevron_down"
        android:tint="?attr/colorOnSurface" />

    <View
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:alpha="0.5"
        android:background="?attr/colorOutlineVariant" />

    <ImageButton
        android:id="@+id/findClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/find_close"
        android:src="@drawable/ic_close"
        android:tint="?attr/colorOnSurface" />
</LinearLayout>
