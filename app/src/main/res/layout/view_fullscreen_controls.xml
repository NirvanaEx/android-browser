<?xml version="1.0" encoding="utf-8"?>
<!--
  Fullscreen video controls overlay (Banana-style).

  Visibility model — kept deliberately simple after several rounds of bugs:

    • The ROOT is the single source of truth for visibility. visibility=gone
      while the page is NOT in HTML5 fullscreen → nothing renders, nothing
      consumes touches, nothing leaks over the page video.
    • When the FullScreenFeature reports fullscreen=true, MainActivity sets
      the root to visible. fsTopBar and fsBottomBar are always visible by
      default — they ride the root.
    • Tap on the dim middle area (not on a button) toggles controls vs
      "video only" mode — handled by MainActivity by toggling fsTopBar and
      fsBottomBar visibility together.

  No auto-hide timer (the previous rounds of timers + visibility-gone in XML
  + runtime-visible toggling produced situations where the overlay was
  technically active but no control bars were drawn — "controls disappeared"
  bug). Tap = toggle; that's the whole UX.

  IDs are referenced by MainActivity.wireFullscreenOverlay().
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true"
    tools:visibility="visible">

    <!-- ============== Top action row ============== -->
    <LinearLayout
        android:id="@+id/fsTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:background="@drawable/bg_fs_top_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/fsBack"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:src="@drawable/ic_arrow_back"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/fsRepeat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_repeat"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/fsPlaylist"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_playlist"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/fsHd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_hd_box"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/fsPip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_pip"
            android:src="@drawable/ic_pip"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/fsRotate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_rotate_phone"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/fsLock"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- ============== Bottom controls bar ============== -->
    <LinearLayout
        android:id="@+id/fsBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:background="@drawable/bg_fs_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Progress + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/fsSeek"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:progressTint="#FFC536"
                android:progressBackgroundTint="#4D4D4D"
                android:secondaryProgressTint="#4D4D4D"
                android:thumbTint="#FFC536"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/fsTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                tools:text="0:09 / 3:05" />
        </LinearLayout>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/fsVolume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_volume"
                android:tint="#FFFFFF" />

            <!-- Weight spacer. MUST be a fixed 1dp tall: a plain View with
                 wrap_content height measures to the FULL available height
                 (View.getDefaultSize returns the spec size for AT_MOST),
                 which blows this row — and the whole bottom bar — up to
                 full screen. That was the "controls scattered across the
                 screen" bug. -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/fsPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_seek_back"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/fsPlayPause"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginHorizontal="20dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_pause"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/fsNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_seek_forward"
                android:tint="#FFFFFF" />

            <!-- Weight spacer — fixed 1dp, see the comment on its twin above. -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/fsExit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:src="@drawable/ic_fullscreen_exit"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============== Lock ============== -->
    <!--
      Shown only while the player is locked. Locking is the one thing that hides
      the system navigation bar (see MainActivity.refreshSystemBars) and stops
      taps from reaching the video, so there has to be a way back that is itself
      immune to the lock — hence a button rather than "tap anywhere".
    -->
    <ImageButton
        android:id="@+id/fsUnlock"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:padding="0dp"
        android:scaleType="center"
        android:alpha="0.75"
        android:background="@drawable/bg_fs_round"
        android:contentDescription="@string/player_unlock"
        android:src="@drawable/ic_lock"
        android:tint="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <!-- ============== Transient gesture indicators ============== -->
    <!-- Flash labels for double-tap seek (left = back, right = forward) and a
         center readout for the volume/brightness vertical-drag gestures.
         Visibility is owned by PlayerOverlayController; all start gone. -->

    <TextView
        android:id="@+id/fsSeekFlashLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_fs_flash"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="−10 s"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/fsSeekFlashRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_fs_flash"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="+10 s"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/fsGestureIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:background="@drawable/bg_fs_flash"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Volume 60%"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
