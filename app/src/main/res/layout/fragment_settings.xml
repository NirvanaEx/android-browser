<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings.

  A stack of cards, each card a group of rows: leading icon in a tinted circle,
  title, subtitle saying what it's set to right now, one control on the right.
  Sizing and colour live in values/styles.xml — see the long note there for why
  the previous shape (section captions with loose text and buttons floating
  between them) was replaced.

  Order is by how often it's touched. Profile first because it is the one thing
  here that has to be done once and then never again, and burying a one-time
  setup step is how it never gets done.

  IDs are referenced by SettingsBottomSheet.kt via ViewBinding; every id that
  existed before still exists, so nothing had to be rewired to move a row.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="20dp"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/settings_title" />

        <!-- ============== The browser's own account ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_profile" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout
                style="@style/Widget.UpgridBrowser.CardBody"
                android:paddingBottom="14dp">

                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <!-- The monogram is drawn from the name in Kotlin. A photo
                         would need an account service that has one; a letter is
                         a face this account can actually have. -->
                    <TextView
                        android:id="@+id/profileAvatar"
                        style="@style/Widget.UpgridBrowser.Avatar"
                        tools:text="S" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            android:id="@+id/profileName"
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:textSize="17sp"
                            tools:text="superadmin" />

                        <TextView
                            android:id="@+id/profileStatus"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="VPN настроен этим аккаунтом" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/account_sign_in" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== Protection: VPN, uBO, passwords ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_privacy" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout style="@style/Widget.UpgridBrowser.CardBody">

                <LinearLayout
                    android:id="@+id/btnOpenVpn"
                    style="@style/Widget.UpgridBrowser.Row">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/menu_vpn" />

                        <TextView
                            android:id="@+id/vpnSummary"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="Отключён" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowChevron"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_adblock" />

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            android:text="@string/settings_adblock_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAdblock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout
                    android:id="@+id/btnOpenPasswords"
                    style="@style/Widget.UpgridBrowser.Row">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_key" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_open_passwords" />

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            android:text="@string/settings_passwords_hint" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowChevron"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_save_passwords" />

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            android:text="@string/settings_save_passwords_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchSavePasswords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== Search engine ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_search" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout
                style="@style/Widget.UpgridBrowser.CardBody"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <RadioGroup
                    android:id="@+id/engineGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== Appearance ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_appearance" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout
                style="@style/Widget.UpgridBrowser.CardBody"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== Video player ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_player" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout style="@style/Widget.UpgridBrowser.CardBody">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="2dp"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/settings_seek_step" />

                <RadioGroup
                    android:id="@+id/seekStepGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp" />

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_video_play" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_background_playback" />

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            android:text="@string/settings_background_playback_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBackgroundPlayback"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== Google account & sync ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_account" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout style="@style/Widget.UpgridBrowser.CardBody">

                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <!-- Never tint this: the Google mark is four coloured paths
                         and a tint flattens all of them into one. -->
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_row_icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_google" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            android:id="@+id/accountName"
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            tools:text="user@gmail.com" />

                        <TextView
                            android:id="@+id/accountStatus"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="Закладки и история переносятся между устройствами" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccountAction"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_account_connect" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncNow"
                        style="@style/Widget.Material3.Button.TextButton.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_sync"
                        android:text="@string/settings_sync_now" />
                </LinearLayout>

                <TextView
                    android:id="@+id/syncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Последняя синхронизация: сегодня, 14:03" />

                <View
                    style="@style/Widget.UpgridBrowser.RowDivider"
                    android:layout_marginTop="10dp" />

                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_sync" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_auto_sync" />

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            android:text="@string/settings_auto_sync_hint" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== Data the browser is holding ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_data" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.UpgridBrowser.Card">

            <LinearLayout style="@style/Widget.UpgridBrowser.CardBody">

                <!-- Every row here says how much of the thing there is. A row
                     that only reads "Site data" makes you open it to find out
                     whether there is anything to do. -->
                <LinearLayout
                    android:id="@+id/btnOpenSiteData"
                    style="@style/Widget.UpgridBrowser.Row">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cookie" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_open_site_data" />

                        <TextView
                            android:id="@+id/dataSummary"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="Кэш и данные сайтов: 128 МБ" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearData"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_clear_short" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout
                    android:id="@+id/btnOpenDownloads"
                    style="@style/Widget.UpgridBrowser.Row">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_download" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/menu_downloads" />

                        <TextView
                            android:id="@+id/downloadsCount"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="4 файла" />
                    </LinearLayout>

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowChevron"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout
                    android:id="@+id/btnOpenBookmarks"
                    style="@style/Widget.UpgridBrowser.Row">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bookmark" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/menu_bookmarks" />

                        <TextView
                            android:id="@+id/bookmarksCount"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="12 закладок" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearBookmarks"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_clear_short" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <LinearLayout
                    android:id="@+id/btnOpenHistory"
                    style="@style/Widget.UpgridBrowser.Row">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_history" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/menu_history" />

                        <TextView
                            android:id="@+id/browsingCount"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="128 страниц" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearBrowsing"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_clear_short" />
                </LinearLayout>

                <View style="@style/Widget.UpgridBrowser.RowDivider" />

                <!-- Past search queries have no screen of their own; they only
                     ever show up as drop-down rows. So this one reads and
                     clears, and doesn't pretend to open anything. -->
                <LinearLayout style="@style/Widget.UpgridBrowser.Row.Static">

                    <ImageView
                        style="@style/Widget.UpgridBrowser.RowIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_find" />

                    <LinearLayout style="@style/Widget.UpgridBrowser.RowText">

                        <TextView
                            style="@style/Widget.UpgridBrowser.RowTitle"
                            android:text="@string/settings_section_history" />

                        <TextView
                            android:id="@+id/historyCount"
                            style="@style/Widget.UpgridBrowser.RowSubtitle"
                            tools:text="3 запроса" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearHistory"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/settings_clear_short" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============== About ============== -->

        <TextView
            style="@style/Widget.UpgridBrowser.GroupHeader"
            android:text="@string/settings_section_about" />

        <!-- Which build is actually on the phone — the first question worth
             answering when a bug report comes in over Telegram. -->
        <TextView
            android:id="@+id/versionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Версия 0.2.0.12 · a1b2c3d" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
