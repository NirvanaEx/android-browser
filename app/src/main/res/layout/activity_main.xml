<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level browser layout:
   - Topbar: home + URL chip + video-PiP button (conditional) + menu trigger.
   - GeckoEngineView in the middle.
   - Speed-dial start page overlaying the engine when tab is at about:blank.
   - FindInPageBar pinned above the bottom bar, GONE until invoked.
   - Bottom bar: 5-slot Banana-style row: forward / adblock-shield / bookmarks
     / reader / tabs. Menu moved to topbar; back is the system gesture.

  Hairline dividers above the bottom bar and below the toolbar give a subtle
  "raised" feeling without elevation shadows that don't render upward.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!--
      Topbar — 4 slots in a row:
        1. btnTopHome   — always visible
        2. BrowserToolbar (URL chip)  — flex, takes leftover width
        3. btnTopVideo  — VISIBLE only while a tab has playing media; tap
                          enters Picture-in-Picture
        4. btnTopMenu   — always visible; opens AppMenuPopup
      Menu was originally in the bottom bar; moving it up frees a slot there
      and matches Banana's right-anchored dropdown. The video button replaces
      the old floating PiP FAB so play/pause/seek live in one consistent place.
    -->
    <LinearLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingVertical="4dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnTopHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            android:tint="?attr/colorOnSurface" />

        <mozilla.components.browser.toolbar.BrowserToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_toolbar" />

        <ImageButton
            android:id="@+id/btnTopVideo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:scaleType="center"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_video_pip"
            android:src="@drawable/ic_video_play"
            android:tint="?attr/colorPrimary"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnTopMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_menu"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Engine view + overlays share the same constraint slot. Z-order
      (later sibling on top) puts startPage above the engine, and the PiP
      FAB above both.
    -->
    <mozilla.components.browser.engine.gecko.GeckoEngineView
        android:id="@+id/engineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/findInPageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start page (speed dial). Inflated as <include> so view binding picks up the inner ids. -->
    <include
        android:id="@+id/startPage"
        layout="@layout/view_start_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/findInPageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Mozilla's built-in find-in-page bar. Sits between engine view and the
      bottom bar; height collapses when GONE so layout stays clean otherwise.
    -->
    <mozilla.components.feature.findinpage.view.FindInPageBar
        android:id="@+id/findInPageBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Banana-style bottom bar: 5 evenly-distributed slots. Menu moved to the
      topbar (btnTopMenu); freeing a slot here keeps each tap target generous.

        1. btnForward         — page forward (back is the system gesture)
        2. btnAdblockShield   — instant uBO toggle. Icon flips between
                                ic_shield (ON, primary tint) and ic_shield_off
                                (OFF, dimmed). Tap = toggle, no menu hop.
        3. btnBookmarks       — Phase 3 stub; toast for now.
        4. btnReader          — Phase 3+ stub; toast for now.
        5. btnTabs            — opens the tabs page. The TextView inside
                                shows the live tab count badge.
    -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_forward"
            android:src="@drawable/ic_arrow_forward"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnAdblockShield"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_adblock"
            android:src="@drawable/ic_shield"
            android:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnBookmarks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_bookmarks"
            android:src="@drawable/ic_bookmark"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnReader"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_reader"
            android:src="@drawable/ic_reader"
            android:tint="?attr/colorOnSurface" />

        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_tabs"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/tab_counter_bg"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="3" />
        </FrameLayout>
    </LinearLayout>

    <!--
      Fullscreen video controls overlay. Sits as the very last child so it's
      drawn on top of the engine view and any chrome. Visibility is owned by
      MainActivity: shown when FullScreenFeature reports the page video has
      gone fullscreen, hidden otherwise. See [view_fullscreen_controls.xml]
      for the UI layout.
    -->
    <include
        android:id="@+id/fsOverlay"
        layout="@layout/view_fullscreen_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
