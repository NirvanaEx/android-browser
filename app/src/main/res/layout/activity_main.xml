<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level browser layout. Everything the browser offers lives in ONE bar at
  the top; the page gets the entire rest of the screen. (The old five-slot
  bottom bar and where each of its buttons went is documented in CLAUDE.md.)

  Row, left to right:
    1. btnTopHome   — always visible
    2. toolbarPill  — the URL chip; flex, takes the leftover width
    3. btnTopVideo  — hidden on the start page; hands the page's <video> to the
                      built-in player
    4. btnTopTabs   — tab counter badge, opens the tabs screen
    5. btnTopMenu   — opens AppMenuPopup

  Alignment is load-bearing here and was previously off. Three things fix it:
    - the row is a fixed 56dp with gravity=center_vertical, so nothing depends
      on the tallest child to define the centre line;
    - every icon target is the same 44dp square, so they share one baseline
      instead of each centring inside a different box;
    - the URL chip is the full 56dp, and its pill is drawn by an inset
      drawable rather than by shrinking the view. android-components lays the
      toolbar out for exactly 56dp and top-anchors its children with fixed
      margins, so a shorter container drags the URL text below centre — see
      the comment in res/drawable/bg_toolbar.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnTopHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            android:tint="?attr/colorOnSurface" />

        <!--
          Full row height on purpose: the toolbar inside needs its 56dp, and
          the visible pill comes from the drawable's 8dp top/bottom inset.
          Only the trailing padding is ours — it keeps the bookmark star off
          the pill's rounded end. The leading edge needs none: the library's
          own layouts already inset the URL by 8dp (edit mode) or by the 40dp
          security indicator (display mode).
        -->
        <FrameLayout
            android:id="@+id/toolbarPill"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:paddingEnd="4dp"
            android:background="@drawable/bg_toolbar">

            <mozilla.components.browser.toolbar.BrowserToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnTopVideo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:scaleType="center"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_video_pip"
            android:src="@drawable/ic_video_play"
            android:tint="?attr/colorPrimary"
            tools:visibility="visible" />

        <!--
          Tab counter. A FrameLayout rather than an ImageButton because the
          badge IS the icon — the number inside the rounded-square frame is how
          every mobile browser draws this.
        -->
        <FrameLayout
            android:id="@+id/btnTopTabs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_tabs"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:includeFontPadding="false"
                android:background="@drawable/tab_counter_bg"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="3" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnTopMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_menu"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!--
      Page load progress. Ours rather than the toolbar's built-in one, which is
      a child of BrowserToolbar and therefore only as wide as the URL chip —
      a progress bar that stops two thirds of the way across the screen reads
      as a stuck load. The library's copy is suppressed by overriding
      mozac_browser_toolbar_progress_bar_height to 0dp in values/dimens.xml.
    -->
    <ProgressBar
        android:id="@+id/pageProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:max="100"
        android:indeterminate="false"
        android:visibility="gone"
        android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"
        tools:progress="40" />

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintTop_toBottomOf="@id/pageProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Mozilla's find-in-page bar, directly under the toolbar. It used to be
      pinned to the bottom of the window, where the keyboard covered it
      completely — the window is adjustNothing, so nothing moves out of the
      IME's way and the bar you were meant to type into was behind it. Up here
      it sits next to the field it searches. Height collapses when GONE, so the
      page takes the full screen in the normal case.
    -->
    <mozilla.components.feature.findinpage.view.FindInPageBar
        android:id="@+id/findInPageBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Engine view + overlays share the same constraint slot. Z-order (later
      sibling on top) puts the start page above the engine, the suggestions
      above that, and the player overlay above everything.
    -->
    <mozilla.components.browser.engine.gecko.GeckoEngineView
        android:id="@+id/engineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/findInPageBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start page (speed dial). Inflated as <include> so view binding picks up the inner ids. -->
    <include
        android:id="@+id/startPage"
        layout="@layout/view_start_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/findInPageBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Omnibar suggestions: bookmarks, then visited pages, then past searches,
      then what the search engine thinks you're typing.

      Two things here are corrections, not preferences:

        - vertical_bias=0. A wrap_content view constrained top AND bottom is
          *centred* by ConstraintLayout, which parked the whole list halfway
          down the screen, floating above the keyboard instead of hanging off
          the address bar. The bottom constraint has to stay (it's what caps
          the height), so the bias is what pins it up.
        - its own surface colour. On colorSurface the panel was the same shade
          as the page behind it and read as loose text scattered over the start
          page rather than as a drop-down.

      The max height is because the window is adjustNothing (GeckoView does its
      own keyboard handling and reflowing the page under it is worse). Nothing
      shrinks the layout when the IME comes up, so without a cap the list would
      draw rows behind the keyboard where they can't be tapped.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestionsList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@drawable/bg_suggestions"
        android:elevation="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_default="wrap"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="300dp"
        tools:visibility="visible" />

    <!--
      Fullscreen video controls overlay. Last child so it draws on top of the
      engine view and any chrome. Visibility is owned by MainActivity.
    -->
    <include
        android:id="@+id/fsOverlay"
        layout="@layout/view_fullscreen_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
