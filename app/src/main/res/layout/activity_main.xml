<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level browser layout. Everything the browser offers lives in ONE bar at
  the top; the page gets the entire rest of the screen. (The old five-slot
  bottom bar and where each of its buttons went is documented in CLAUDE.md.)

  Row, left to right:
    1. btnTopHome    — always visible
    2. toolbarPill   — the URL chip; flex, takes the leftover width
    3. btnTopVideo   — hidden on the start page; hands the page's <video> to the
                       built-in player
    4. btnTopNewTab  — a blank tab, selected
    5. btnTopTabs    — tab counter badge, opens the tabs screen
    6. btnTopMenu    — opens AppMenuPopup

  On a tablet a strip of tabs sits above that row, desktop-style — see
  `tabStripRow`, which is `gone` on a phone.

  All of it is an AppBarLayout inside a CoordinatorLayout, which is what makes
  the bar retract under the finger instead of blinking out of existence. See
  the note on `browserFrame` below.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:fitsSystemWindows="true">

    <!--
      The chrome and the page, coordinated.

      This is a CoordinatorLayout for exactly one reason: it is the only way to
      make the top bar retract *with the finger*. GeckoView (NestedGeckoView)
      is a nested-scroll child, PullToRefreshLayout passes the scroll through,
      and AppBarLayout's behaviour eats it — so dragging up by 20dp slides the
      bar 20dp out of the way and does not scroll the page at all. The content
      stays exactly where the finger left it.

      Everything else that was tried moves the page: shortening a column and
      sliding the page up over it jumps by the height of the bar, and resizing
      the engine view makes Gecko reflow. Neither is what the eye expects, and
      both read as the screen shaking.

      appbar_scrolling_view_behavior is what positions the page under the bar.
      The scrolling view is measured at the FULL height of the frame and then
      offset down by however much of the bar is showing — so it is never
      re-measured while the bar moves, and at rest there is exactly one bar's
      worth of space above the page. That is the "invisible inset": it is the
      layout, not a margin drawn into the page.
    -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/browserFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <!--
      All the chrome, in one column.

      Order is load-bearing here, not tidiness: AppBarLayout collapses by
      sliding *itself* up by the summed height of the children that carry the
      `scroll` flag, so those have to come first. The tab strip and the toolbar
      row scroll away; the progress line, the hairline and the three page bars
      have no flags and end up pinned at the top of the screen once the bar is
      gone — which is right for all three. Find and translate are part of
      *typing*, so they have to stay above the keyboard — the window is
      adjustNothing.
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!--
          Tablets only (see bools.xml): the open tabs across the top, the way a
          desktop browser has them, so switching is one tap instead of a trip
          to another screen. A phone has neither the width for it nor the
          screen to spare, and keeps the counter button.

          Carries the same scroll flags as the toolbar row: on a tablet the
          whole header goes away while you read and comes back on the way up.
        -->
        <LinearLayout
            android:id="@+id/tabStripRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:visibility="gone"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            tools:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabStrip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none" />

            <ImageButton
                android:id="@+id/btnStripNewTab"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tabs_tray_new"
                android:src="@drawable/ic_add"
                android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolbarWrapper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_scrollFlags="scroll|enterAlways|snap"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:background="?attr/colorSurface">

            <ImageButton
                android:id="@+id/btnTopHome"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_home"
                android:tint="?attr/colorOnSurface" />

            <!--
              paddingTop/paddingBottom="0dp" are load-bearing, not tidiness.

              bg_toolbar is an <inset> drawable, and InsetDrawable.getPadding()
              reports its insets as padding. A View adopts its background's padding
              for every edge the layout doesn't name, so this container silently
              gained 8dp top and bottom — which left BrowserToolbar 40dp tall inside
              a 56dp row. android-components lays its toolbar out for exactly 56dp
              and top-anchors the site-info icon and the page actions with fixed
              margins, so both landed 8dp below the centre line while the URL text
              (constrained top AND bottom) stayed centred. That is the entire reason
              the icons looked crooked next to level text. Naming the padding
              overrides the drawable's; the pill still draws inset, because insets
              affect where the drawable paints, not how tall the view is.
            -->
            <FrameLayout
                android:id="@+id/toolbarPill"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingEnd="4dp"
                android:background="@drawable/bg_toolbar">

                <mozilla.components.browser.toolbar.BrowserToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnTopVideo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:scaleType="center"
                android:visibility="gone"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_video_pip"
                android:src="@drawable/ic_video_play"
                android:tint="?attr/colorPrimary"
                tools:visibility="visible" />

            <!--
              New tab, right where Chrome puts it: between the address and the
              tab counter, so "make one" and "see them all" are neighbours.

              It duplicates the ⊕ inside the tabs screen on purpose. That one
              costs two taps and a screen you didn't want to look at; from a
              page you are reading, opening a blank tab is a thing you do
              without stopping to think, and it should cost one tap.
            -->
            <ImageButton
                android:id="@+id/btnTopNewTab"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tabs_tray_new"
                android:src="@drawable/ic_add"
                android:tint="?attr/colorOnSurface" />

            <!--
              Tab counter. A FrameLayout rather than an ImageButton because the
              badge IS the icon — the number inside the rounded-square frame is how
              every mobile browser draws this.
            -->
            <FrameLayout
                android:id="@+id/btnTopTabs"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_tabs"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:id="@+id/tabCount"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:background="@drawable/tab_counter_bg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="3" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnTopMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="0dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nav_menu"
                android:src="@drawable/ic_more_vert"
                android:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <!--
          Page load progress. Ours rather than the toolbar's built-in one, which is
          a child of BrowserToolbar and therefore only as wide as the URL chip —
          a progress bar that stops two thirds of the way across the screen reads
          as a stuck load. The library's copy is suppressed by overriding
          mozac_browser_toolbar_progress_bar_height to 0dp in values/dimens.xml.
        -->
        <ProgressBar
            android:id="@+id/pageProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:indeterminate="false"
            android:visibility="gone"
            android:progressTint="?attr/colorPrimary"
            android:progressBackgroundTint="@android:color/transparent"
            tools:visibility="visible"
            tools:progress="40" />

        <View
            android:id="@+id/toolbarDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.6" />

        <!--
          Find in page. Ours rather than mozilla's FindInPageBar, because the two
          things the user asked for are both outside what that bar exposes: a
          Chrome-coloured highlight (orange for the current match, yellow for the
          rest) and a guarantee that the page scrolls to the match. Both are decided
          in the page, so the search itself now happens there too — see
          assets/extensions/upgrid_fullscreen/find.js.

          Height collapses when GONE, so the page keeps the full screen normally.
        -->
        <include
            android:id="@+id/findBar"
            layout="@layout/view_find_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Translation state + language switch. Same slot, same reasoning. -->
        <include
            android:id="@+id/translateBar"
            layout="@layout/view_translate_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!--
          "This page is old." Below the other two rather than sharing their slot:
          find and translate are things the user opened, this is something the
          browser noticed, and one shouldn't hide the other.
        -->
        <include
            android:id="@+id/staleBar"
            layout="@layout/view_stale_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <!--
      Engine view + overlays share one slot under the bar. Z-order (later
      sibling on top) puts the start page above the engine and the player
      overlay above everything.

      The engine view is the refresh layout's only child on purpose: both
      SwipeRefreshFeature and PullToRefreshLayout identify the page by asking
      whether the direct child is an EngineView, and anything else answers
      "the child can scroll", which disables the gesture outright.
    -->
    <com.upgrid.browser.ui.PullToRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <mozilla.components.browser.engine.gecko.GeckoEngineView
            android:id="@+id/engineView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.upgrid.browser.ui.PullToRefreshLayout>

    <!--
      The page, as a picture, for the moments the real one can't be seen.

      GeckoView draws into a SurfaceView, which is not part of this window: it
      is a separate layer behind it, and the window punches a transparent hole
      where it sits. Everything the system does with a *picture* of the window
      therefore gets the hole and not the page — most visibly the card in the
      recents list, which showed the address bar floating over the wallpaper
      with nothing underneath it.

      So while the activity isn't on screen, the last captured frame is laid
      over that hole by an ordinary ImageView, which the window does draw. Same
      pixels the user just saw; the swap happens after onPause and is undone in
      onResume, so it is never visible as a change. See MainActivity.showPageCover.
    -->
    <ImageView
        android:id="@+id/pageCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:scaleType="fitXY"
        android:background="?attr/colorSurface"
        android:importantForAccessibility="no"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Start page (speed dial). Inflated as <include> so view binding picks up
         the inner ids. Same behaviour as the page it stands in for, so it sits
         under the bar; its own nested scrolling is switched off in code, since
         a speed dial is not something you should be able to hide the address
         bar with. -->
    <include
        android:id="@+id/startPage"
        layout="@layout/view_start_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!--
      Omnibar suggestions: bookmarks, then visited pages, then past searches,
      then what the search engine thinks you're typing.

      Two things here are corrections, not preferences:

        - vertical_bias=0. A wrap_content view constrained top AND bottom is
          *centred* by ConstraintLayout, which parked the whole list halfway
          down the screen, floating above the keyboard instead of hanging off
          the address bar. The bottom constraint has to stay (it's what caps
          the height), so the bias is what pins it up.
        - it hangs off the root at a fixed 62dp rather than off the bar: the
          bar lives inside a CoordinatorLayout now and there is nothing in the
          root to constrain to. 62 is the bar (56) plus its hairline and a
          hair of clearance, and a constant is right here because the drop-down
          only exists while the address bar is being typed into, and editing
          forces the bar fully open (see MainActivity.onStartEditing).
        - its own surface colour, inset from both edges and elevated. On
          colorSurface, full width, the panel was the same shade as the page
          behind it and read as loose text scattered over the start page rather
          than as a drop-down.

      The max height is because the window is adjustNothing (GeckoView does its
      own keyboard handling and reflowing the page under it is worse). Nothing
      shrinks the layout when the IME comes up, so without a cap the list would
      draw rows behind the keyboard where they can't be tapped.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestionsList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_suggestions"
        android:elevation="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintHeight_default="wrap"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="336dp"
        tools:visibility="visible" />

    <!--
      Fullscreen video controls overlay. Last child so it draws on top of the
      engine view and any chrome. Visibility is owned by MainActivity.
    -->
    <include
        android:id="@+id/fsOverlay"
        layout="@layout/view_fullscreen_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
