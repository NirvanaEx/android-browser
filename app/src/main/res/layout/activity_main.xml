<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level browser layout. Everything the browser offers lives in ONE bar at
  the top; the page gets the entire rest of the screen.

  There used to be a second, five-slot bar pinned to the bottom. It cost ~60dp
  of page height permanently, sat exactly where the system gesture bar and most
  sites' own sticky footers are, and held two buttons that were never
  implemented. Its contents didn't vanish with it:

    forward / reload / back  → quick-action row at the top of the app menu
    adblock shield           → app menu row (with its ON/OFF pill) + Settings
    bookmarks                → app menu, and the star in that same quick row
    reader view              → dropped; it was a "coming soon" toast
    tabs                     → moved up here, counter and all

  Row layout, left to right:
    1. btnTopHome   — always visible
    2. BrowserToolbar (URL chip) — flex, takes the leftover width
    3. btnTopVideo  — hidden on the start page; hands the page's <video> to the
                      built-in player
    4. btnTopTabs   — tab counter badge, opens the tabs tray
    5. btnTopMenu   — opens AppMenuPopup

  Four 40dp buttons leave ~180dp for the URL on a 360dp-wide phone. The URL is
  elided anyway, and the alternative — a second row — is the thing being
  removed here.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingVertical="3dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnTopHome"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            android:tint="?attr/colorOnSurface" />

        <mozilla.components.browser.toolbar.BrowserToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_toolbar" />

        <ImageButton
            android:id="@+id/btnTopVideo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:scaleType="center"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_video_pip"
            android:src="@drawable/ic_video_play"
            android:tint="?attr/colorPrimary"
            tools:visibility="visible" />

        <!--
          Tab counter. A FrameLayout rather than an ImageButton because the
          badge IS the icon — the number inside the rounded-square frame is how
          every mobile browser draws this, and it doubles as the tab count
          readout that used to live in the bottom bar.
        -->
        <FrameLayout
            android:id="@+id/btnTopTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_tabs"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/tab_counter_bg"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="3" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnTopMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="0dp"
            android:scaleType="center"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_menu"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Engine view + overlays share the same constraint slot. Z-order (later
      sibling on top) puts the start page above the engine and the player
      overlay above both.
    -->
    <mozilla.components.browser.engine.gecko.GeckoEngineView
        android:id="@+id/engineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/findInPageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start page (speed dial). Inflated as <include> so view binding picks up the inner ids. -->
    <include
        android:id="@+id/startPage"
        layout="@layout/view_start_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/findInPageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Mozilla's built-in find-in-page bar, now pinned straight to the bottom of
      the window. Height collapses when GONE, so the engine view takes the full
      screen in the normal case.
    -->
    <mozilla.components.feature.findinpage.view.FindInPageBar
        android:id="@+id/findInPageBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Fullscreen video controls overlay. Last child so it draws on top of the
      engine view and any chrome. Visibility is owned by MainActivity.
    -->
    <include
        android:id="@+id/fsOverlay"
        layout="@layout/view_fullscreen_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
