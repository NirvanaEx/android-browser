<?xml version="1.0" encoding="utf-8"?>
<!--
  Top-level browser layout:
   - BrowserToolbar (Mozilla) at the top, on a soft surface chip.
   - GeckoEngineView in the middle.
   - Speed-dial start page overlaying the engine when tab is at about:blank.
   - Floating PiP button overlay shown while media is playing.
   - FindInPageBar pinned above the bottom bar, GONE until invoked.
   - Banana-style 6-slot bottom bar: forward / adblock-shield / bookmarks /
     reader / tabs / menu. Back is the system gesture; home moved to topbar.

  Hairline dividers above the bottom bar and below the toolbar give a subtle
  "raised" feeling without elevation shadows that don't render upward.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <!--
      Topbar: Banana-style home button on the left + the BrowserToolbar chip
      taking the rest of the row. The wrapper paints the chrome surface so the
      home button sits flush with the rest of the bar; the toolbar itself keeps
      its rounded chip background via @drawable/bg_toolbar.
    -->
    <LinearLayout
        android:id="@+id/toolbarWrapper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:paddingVertical="4dp"
        android:background="?attr/colorSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnTopHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_home"
            android:tint="?attr/colorOnSurface" />

        <mozilla.components.browser.toolbar.BrowserToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toolbar" />
    </LinearLayout>

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintTop_toBottomOf="@id/toolbarWrapper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Engine view + overlays share the same constraint slot. Z-order
      (later sibling on top) puts startPage above the engine, and the PiP
      FAB above both.
    -->
    <mozilla.components.browser.engine.gecko.GeckoEngineView
        android:id="@+id/engineView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/findInPageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start page (speed dial). Inflated as <include> so view binding picks up the inner ids. -->
    <include
        android:id="@+id/startPage"
        layout="@layout/view_start_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider"
        app:layout_constraintBottom_toTopOf="@id/findInPageBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Floating Picture-in-Picture trigger. MainActivity flips its visibility
      based on the selected tab's mediaSessionState; tap → enterPictureInPictureMode.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pipFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:visibility="gone"
        android:contentDescription="@string/nav_pip"
        android:src="@drawable/ic_pip"
        app:tint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:fabSize="normal"
        app:layout_constraintEnd_toEndOf="@id/engineView"
        app:layout_constraintBottom_toBottomOf="@id/engineView"
        tools:visibility="visible" />

    <!--
      Mozilla's built-in find-in-page bar. Sits between engine view and the
      bottom bar; height collapses when GONE so layout stays clean otherwise.
    -->
    <mozilla.components.feature.findinpage.view.FindInPageBar
        android:id="@+id/findInPageBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/bottomDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.6"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Banana-style bottom bar: 6 evenly-distributed slots. Each child uses
      weight=1 so the row stays balanced on any screen width. Order is fixed by
      the design and depended on by MainActivity.wireBottomBar().

        1. btnForward         — page forward (back is the system gesture)
        2. btnAdblockShield   — instant uBO toggle. Icon flips between
                                ic_shield (ON, primary tint) and ic_shield_off
                                (OFF, dimmed). Tap = toggle, no menu hop.
        3. btnBookmarks       — Phase 3 stub; toast for now.
        4. btnReader          — Phase 3+ stub; toast for now.
        5. btnTabs            — opens TabsTrayFragment. The TextView inside
                                shows the live tab count badge.
        6. btnMenu            — opens MenuBottomSheet (everything else).
    -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_forward"
            android:src="@drawable/ic_arrow_forward"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnAdblockShield"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_adblock"
            android:src="@drawable/ic_shield"
            android:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnBookmarks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_bookmarks"
            android:src="@drawable/ic_bookmark"
            android:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnReader"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_reader"
            android:src="@drawable/ic_reader"
            android:tint="?attr/colorOnSurface" />

        <FrameLayout
            android:id="@+id/btnTabs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_tabs"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/tabCount"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/tab_counter_bg"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="3" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_menu"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/colorOnSurface" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
