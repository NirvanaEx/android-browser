<?xml version="1.0" encoding="utf-8"?>
<!--
  One visited page. Leading tile shows the host's first letter (we don't fetch
  favicons here — the list scrolls fast and a letter never pops in late), then
  title over URL, the visit time, and a trash button.

  IDs are bound in HistoryAdapter.EntryHolder.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/historyInitial"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:background="@drawable/bg_favicon"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="G" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Upgrid Browser — GitHub" />

        <TextView
            android:id="@+id/historyUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="https://github.com/NirvanaEx/android-browser" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="14:03" />

    <ImageButton
        android:id="@+id/btnDeleteEntry"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/history_delete_entry"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
