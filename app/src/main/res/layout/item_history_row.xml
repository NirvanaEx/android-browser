<?xml version="1.0" encoding="utf-8"?>
<!--
  One visited page.

  The leading tile carries the host's first letter on a color derived from the
  host itself (see HostTile), so a long history reads as bands of the same few
  sites rather than a uniform wall of text. The same tile appears in bookmarks,
  the tabs grid and the speed dial — one site looks the same everywhere.

  Time moved from the right edge to under the title: there it competed with the
  delete button for the same corner and squeezed the URL into an ellipsis two
  characters in.

  IDs are bound in HistoryAdapter.EntryHolder.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/historyInitial"
        style="@style/Widget.UpgridBrowser.HostTile"
        tools:text="G" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            tools:text="Upgrid Browser — GitHub" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/historyTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                tools:text="14:03" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/dot_separator" />

            <TextView
                android:id="@+id/historyUrl"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="github.com/NirvanaEx/android-browser" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteEntry"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/history_delete_entry"
        android:src="@drawable/ic_delete"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
