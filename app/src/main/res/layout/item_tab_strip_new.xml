<?xml version="1.0" encoding="utf-8"?>
<!--
  The "+" at the end of the tablet's tab strip.

  A row in the strip rather than a button pinned to its right edge: it belongs
  immediately after the last tab, which is where every desktop browser puts it
  and where the eye looks for it. Pinned to the edge it floated in empty space
  whenever there were only two or three tabs open.

  The trade is that with enough tabs to fill the strip it scrolls off with them.
  That is the same trade Chrome makes, and the tab counter in the toolbar still
  opens a new tab from anywhere.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/tab_strip_new_width"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/btnStripNewTab"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:padding="0dp"
        android:scaleType="center"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tabs_tray_new"
        android:src="@drawable/ic_add"
        app:tint="?attr/colorOnSurfaceVariant" />
</FrameLayout>
