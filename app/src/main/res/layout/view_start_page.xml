<?xml version="1.0" encoding="utf-8"?>
<!--
  The start page. Sits as an overlay on top of GeckoEngineView and is toggled
  visible by MainActivity whenever the selected tab is at about:blank.

  Two states, and only one of them is ever on screen:

    [normal]  brand row, SHORTCUTS, RECENT — the two lists that are the user's
              own. Tiles are inflated into [quickLinksGrid] by
              StartPagePresenter in rows of R.integer.start_page_columns (four
              on a phone, six on a tablet); RECENT is hidden entirely when
              there is no history, since a caption over an empty box reads as
              something missing rather than as somewhere you haven't been.
    [private] one explanation of what this mode does and does not do. No
              shortcuts and no history: on a screen whose whole point is
              leaving no trace, a list of the places you go is the wrong
              furniture.

  **No cards.** The shortcuts sat in a filled container for exactly one
  release; a grey slab behind eight icons is a box drawn around things that
  don't need one, and the owner said so. Captions carry the grouping now, which
  is all it needed.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/startPageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/startNormal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/start_page_top"
            android:paddingBottom="28dp"
            android:paddingStart="@dimen/start_page_side"
            android:paddingEnd="@dimen/start_page_side">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_brand_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/app_name" />
            </LinearLayout>

            <TextView
                style="@style/Widget.UpgridBrowser.StartCaption"
                android:text="@string/start_page_quick_links" />

            <LinearLayout
                android:id="@+id/quickLinksGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Everything below is gone until there is history to show. -->
            <LinearLayout
                android:id="@+id/recentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    style="@style/Widget.UpgridBrowser.StartCaption"
                    android:text="@string/start_page_recent" />

                <LinearLayout
                    android:id="@+id/recentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/btnAllHistory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="?attr/colorPrimary"
                        android:text="@string/start_page_all_history" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!--
          The private tab's start page. What this mode does, and — the half
          every browser used to leave out — what it doesn't.
        -->
        <LinearLayout
            android:id="@+id/startPrivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="64dp"
            android:paddingBottom="32dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_incognito"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/private_page_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/private_page_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="3dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/private_page_caveat" />
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
