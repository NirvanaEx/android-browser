<?xml version="1.0" encoding="utf-8"?>
<!--
  Speed-dial start page. Sits as an overlay on top of GeckoEngineView and is
  toggled visible by MainActivity whenever the selected tab is at about:blank.

  Tiles are inflated programmatically into [quickLinksGrid] from
  [QuickLink.SEED] — 4 per row, two rows. We emit horizontal LinearLayout rows
  on the fly to avoid pulling in androidx.gridlayout for an 8-cell static grid.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startPageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_horizontal">

        <!-- Brand wordmark / hero. Primary tint on surface — no separate logo asset. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.04"
            android:textColor="?attr/colorPrimary"
            android:text="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="@string/start_page_tagline" />

        <LinearLayout
            android:id="@+id/quickLinksGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
