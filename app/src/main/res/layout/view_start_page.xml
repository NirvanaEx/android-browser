<?xml version="1.0" encoding="utf-8"?>
<!--
  The start page. Sits as an overlay on top of GeckoEngineView and is toggled
  visible by MainActivity whenever the selected tab is at about:blank.

  Two parts:

    1. the brand lockup — the launcher's own mark above the name, rather than
       the name alone set in 34sp of light blue. A wordmark on its own is what
       a page looks like before its stylesheet loads;
    2. the shortcuts, in a card. The grid used to float on the background with
       nothing around it, which reads as leftover space rather than as a
       section — and this app already says "a group of things" with a card
       everywhere else (see values/styles.xml).

  There was a third: a search field above the card that handed focus to the
  address bar. Removed at the owner's request — the address bar is directly
  above it, and a second one that isn't really a field is one thing too many
  on a screen this small.

  Tiles are inflated into [quickLinksGrid] by StartPagePresenter, in rows of
  R.integer.start_page_columns — four on a phone, six on a tablet.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startPageScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/start_page_top"
        android:paddingBottom="28dp"
        android:paddingStart="@dimen/start_page_side"
        android:paddingEnd="@dimen/start_page_side"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_brand_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.01"
            android:textColor="?attr/colorOnSurface"
            android:text="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="@string/start_page_tagline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_start_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary"
                android:text="@string/start_page_quick_links" />

            <LinearLayout
                android:id="@+id/quickLinksGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
