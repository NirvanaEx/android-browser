<?xml version="1.0" encoding="utf-8"?>
<!--
  What the FileProvider is allowed to hand out: only the Downloads directory
  inside the app's own external storage, which is where DownloadManager writes
  on Android 9 and below. Nothing else the app stores is shareable.
-->
<paths>
    <external-files-path
        name="downloads"
        path="Download/" />
</paths>
