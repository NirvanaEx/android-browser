<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by GeckoView for networking and to download uBO XPI. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- One notification, and only while the VPN is connected: what it is
         connected to, and a button to disconnect. Asked for at the moment the
         user connects, not on first launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Only so Settings can raise the system's own one-tap "keep this app in
      memory?" dialog. Without it that intent is refused and the user has to
      find the app in a list of everything installed. Nothing is done with it
      silently: the browser never asks on its own, and the answer belongs to
      the user. (This is why the app is not on Google Play — the store treats
      this permission as reserved for alarms and messengers.)
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optional: lets the user install browser as default. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".BrowserApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.UpgridBrowser"
        android:usesCleartextTraffic="false">

        <!--
          windowSoftInputMode is two decisions.

          stateAlwaysHidden, not stateUnspecified: the URL field is the first
          focusable view in the layout, so on every resume the system handed it
          focus and raised the keyboard over a page nobody was typing into. The
          root view takes initial focus (see focusableInTouchMode in
          activity_main.xml); this stops the IME following it back.

          adjustNothing stays — GeckoView does its own keyboard handling and
          reflowing the page under the IME is worse than covering it. Which is
          why every piece of chrome that has to stay reachable while typing —
          find in page, the suggestion list — lives at the TOP of the screen.
        -->
        <!--
          alwaysRetainTaskState: come back to what was on screen, however long
          it's been.

          Android trims a task's state after roughly half an hour away — it
          drops everything above the root activity and clears the intent that
          started it, on the theory that after a break you want to start over.
          That theory is wrong for a browser: what was open is precisely what
          you came back for, and the browser has its own restore
          (SessionStorage) that this flag stops the system second-guessing.
        -->
        <!--
          Orientation is NOT declared here. It used to be `portrait` on every
          activity, which was right for a phone and absurd on a tablet — a
          device whose natural posture is landscape, locked upright by a
          hard-coded attribute that no resource qualifier can reach.
          BrowserApplication.lockOrientationOnPhones does it instead, once, for
          every screen, off the same sw600dp bool that turns on the tab strip.

          configChanges already lists orientation, so the player's landscape
          request (MainActivity.toggleFsOrientation) is a resize, not a rebuild.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation"
            android:resizeableActivity="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets the user pick this app as default browser / open links from other apps. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!--
          Library screens. Not exported: nothing outside the app has any
          business opening the user's history or bookmarks by intent, and an
          exported activity here would be exactly that.

          They talk to the process-wide BrowserStore rather than returning a
          result, so MainActivity needs no plumbing to receive their outcome —
          it re-renders from the store like it does for everything else.
        -->
        <activity
            android:name=".history.HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".bookmarks.BookmarksActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".tabs.TabsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <!-- Signing in to the browser's own account. adjustResize so the two
             fields stay above the keyboard; excludeFromRecents keeps a typed
             password out of the app switcher's screenshot. -->
        <activity
            android:name=".account.LoginActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".download.DownloadsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <!-- Saved passwords. excludeFromRecents keeps the list out of the app
             switcher's screenshot, which is the one place it could be read
             without unlocking anything. -->
        <activity
            android:name=".logins.LoginsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <activity
            android:name=".privacy.SiteDataActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <!--
          VPN setup. The VpnService itself is declared by the WireGuard tunnel
          library's own manifest (com.wireguard.android.backend.GoBackend$VpnService,
          permission BIND_VPN_SERVICE) and the merger folds it in — declaring a
          second one here would be a duplicate the build rejects.
        -->
        <activity
            android:name=".vpn.VpnActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboard|keyboardHidden|navigation" />

        <!--
          The "Disconnect" button on the VPN notification. Not exported: the
          only thing allowed to drop the user's tunnel is the user's own tap on
          our own notification.
        -->
        <receiver
            android:name=".vpn.VpnActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.upgrid.browser.action.VPN_DISCONNECT" />
            </intent-filter>
        </receiver>

        <!--
          Hands a downloaded file to another app. Only needed below Android 10,
          where downloads land in our own external directory rather than in
          MediaStore and a file:// URI would be refused by the system.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
