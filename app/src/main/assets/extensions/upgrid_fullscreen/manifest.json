{
  "manifest_version": 2,
  "name": "Upgrid Player Helper",
  "version": "4.1.0",
  "description": "Transfers supported video sources to the browser's native player screen.",
  "applications": {
    "gecko": {
      "id": "fullscreen@upgrid.local",
      "strict_min_version": "100.0"
    }
  },
  "background": {
    "scripts": ["player.js", "background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Open in player"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["lifecycle.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }],
  "permissions": [
    "<all_urls>",
    "tabs",
    "activeTab",
    "nativeMessaging",
    "geckoViewAddons"
  ]
}
